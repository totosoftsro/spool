        "content-type",
        "application/json"
      ]
    ],
    "body": {
      "encoding": "json",
      "json": {
        "name": "Ada",
        "email": "ada@example.com"
      }
    }
  },
  "live": {
    "method": "POST",
    "url": "https://api.test/v1/users",
    "headers": [],
    "body": {
      "encoding": "json",
      "json": {
        "name": "Ada",
        "email": "ada@example.com"
      }
    }
  },
  "config": {
    "headers": {
      "mode": "all"
    }
  },
  "expected": {
    "matches": false
  }
