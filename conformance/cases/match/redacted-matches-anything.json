        "authorization",
        "{{redacted}}"
      ]
    ]
  },
  "live": {
    "method": "GET",
    "url": "https://api.test/a",
    "headers": [
      [
        "authorization",
        "Bearer real-token"
      ]
    ]
  },
  "config": {
    "headers": {
      "mode": "all"
    }
  },
  "expected": {
    "matches": true
  }
}
