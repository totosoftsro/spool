{
  "id": "match/headers-all-allows-extra",
  "kind": "match",
  "level": "core",
  "description": "All mode means every recorded header must still be present, not that no header may be added.",
  "recorded": {
    "method": "POST",
    "url": "https://api.test/v1/users",
    "headers": [
      [
        "content-type",
        "application/json"
      ]
    ],
    "body": {
      "encoding": "json",
      "json": {
        "name": "Ada",
        "email": "ada@example.com"
      }
    }
  },
  "live": {
    "method": "POST",
    "url": "https://api.test/v1/users",
    "headers": [
      [
        "content-type",
        "application/json"
      ],
      [
        "user-agent",
        "x"
      ]
    ],
    "body": {
      "encoding": "json",
      "json": {
        "name": "Ada",
        "email": "ada@example.com"
      }
    }
  },
  "config": {
    "headers": {
      "mode": "all"
    }
  },
  "expected": {
    "matches": true
  }
}
