{
  "id": "structural/header-value-htab-allowed",
  "kind": "structural",
  "level": "core",
  "description": "HTAB is the one control character permitted in a field value, so this fixture must load. Included so the CR/LF rule cannot be implemented as a blanket control-character ban.",
  "document": {
    "hif": "1.0",
    "interactions": [
      {
        "request": {
          "method": "GET",
          "url": "https://x.test/a"
        },
        "response": {
          "status": 200,
          "headers": [
            [
              "x-a",
              "a\tb"
            ]
          ]
        }
      }
    ]
  },
  "expected": {
    "error": false
  }
}
