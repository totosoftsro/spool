{
  "id": "structural/json-path-defined-escapes",
  "kind": "structural",
  "level": "core",
  "description": "The three defined escapes must still be accepted; included so the rule above cannot be implemented as a blanket ban on ~.",
  "document": {
    "hif": "1.0",
    "interactions": [
      {
        "request": {
          "method": "GET",
          "url": "https://x.test/a"
        },
        "response": {
          "status": 200
        },
        "match": {
          "body": {
            "json": {
              "ignore": [
                "/a~0b",
                "/a~1b",
                "/~2"
              ]
            }
          }
        }
      }
    ]
  },
  "expected": {
    "error": false
  }
}
