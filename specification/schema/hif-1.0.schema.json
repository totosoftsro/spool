{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.hif.dev/hif-1.0.schema.json",
  "title": "HTTP Interaction Fixture (HIF) 1.0",
  "description": "Structural schema for HIF 1.0 documents. This schema checks shape only. It deliberately does not encode constraints that require cross-field reasoning (unique interaction ids, response/fault exclusivity, regex-subset validation, base64 validity, or the URL normalization of specification section 6.4). A document that validates against this schema may still be rejected by a conforming reader; see specification/hif-1.0.md section 11.3.",
  "type": "object",
  "required": ["hif", "interactions"],
  "properties": {
    "hif": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Spec version, MAJOR.MINOR. Readers reject a differing major version."
    },
    "meta": { "$ref": "#/$defs/meta" },
    "defaults": { "$ref": "#/$defs/defaults" },
    "interactions": {
      "type": "array",
      "items": { "$ref": "#/$defs/interaction" }
    }
  },

  "$defs": {
    "meta": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "recorder": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" }
          }
        },
        "redaction": {
          "type": "object",
          "properties": {
            "applied": { "type": "boolean" },
            "rules": { "type": "array", "items": { "type": "string" } }
          }
        },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },

    "defaults": {
      "type": "object",
      "properties": {
        "match": { "$ref": "#/$defs/match" },
        "replay": { "$ref": "#/$defs/replay" }
      }
    },

    "interaction": {
      "type": "object",
      "required": ["request"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "request": { "$ref": "#/$defs/request" },
        "response": { "$ref": "#/$defs/response" },
        "match": { "$ref": "#/$defs/match" },
        "replay": { "$ref": "#/$defs/replay" },
        "timing": { "$ref": "#/$defs/timing" },
        "fault": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/fault" }]
        },
        "expect": { "$ref": "#/$defs/expect" },
        "annotations": { "type": "object" }
      }
    },

    "request": {
      "type": "object",
      "required": ["method", "url"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://" },
        "headers": { "$ref": "#/$defs/headers" },
        "body": { "$ref": "#/$defs/body" }
      }
    },

    "response": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "statusText": { "type": "string" },
        "headers": { "$ref": "#/$defs/headers" },
        "body": { "$ref": "#/$defs/body" }
      }
    },

    "headers": {
      "type": "array",
      "description": "Ordered list of [name, value] pairs. The three-element form [name, null, base64Value] carries a field value that is not valid UTF-8 (specification section 6.6).",
      "items": {
        "oneOf": [
          {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [{ "type": "string" }, { "type": "string" }],
            "items": false
          },
          {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "prefixItems": [
              { "type": "string" },
              { "type": "null" },
              { "type": "string" }
            ],
            "items": false
          }
        ]
      }
    },

    "body": {
      "type": "object",
      "required": ["encoding"],
      "properties": {
        "encoding": { "enum": ["empty", "text", "json", "base64"] },
        "text": { "type": "string" },
        "json": true,
        "base64": { "type": "string" },
        "contentType": { "type": "string" },
        "redacted": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "encoding": { "const": "text" } }, "required": ["encoding"] },
          "then": { "required": ["text"] }
        },
        {
          "if": { "properties": { "encoding": { "const": "json" } }, "required": ["encoding"] },
          "then": { "required": ["json"] }
        },
        {
          "if": { "properties": { "encoding": { "const": "base64" } }, "required": ["encoding"] },
          "then": { "required": ["base64"] }
        }
      ]
    },

    "match": {
      "type": "object",
      "properties": {
        "method": { "$ref": "#/$defs/scalarMatch" },
        "scheme": { "$ref": "#/$defs/scalarMatch" },
        "host": { "$ref": "#/$defs/scalarMatch" },
        "port": { "$ref": "#/$defs/scalarMatch" },
        "path": { "$ref": "#/$defs/scalarMatch" },
        "query": {
          "type": "object",
          "properties": {
            "mode": { "enum": ["exact", "subset", "ignore"] },
            "ignore": { "type": "array", "items": { "type": "string" } }
          }
        },
        "headers": {
          "type": "object",
          "properties": {
            "mode": { "enum": ["none", "listed", "all"] },
            "include": { "type": "array", "items": { "type": "string" } },
            "ignore": { "type": "array", "items": { "type": "string" } }
          }
        },
        "body": {
          "type": "object",
          "properties": {
            "mode": { "enum": ["auto", "exact", "json", "text", "ignore"] },
            "json": {
              "type": "object",
              "properties": {
                "extra": { "enum": ["reject", "allow"] },
                "ignore": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/jsonPath" }
                }
              }
            }
          }
        }
      }
    },

    "scalarMatch": { "enum": ["exact", "ignore"] },

    "jsonPath": {
      "type": "string",
      "pattern": "^/",
      "description": "RFC 6901 JSON Pointer, extended with * as a single-token wildcard. ~2 escapes a literal * member name."
    },

    "replay": {
      "type": "object",
      "properties": {
        "times": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "const": "unlimited" }
          ]
        }
      }
    },

    "timing": {
      "type": "object",
      "properties": {
        "latencyMs": { "type": "number", "minimum": 0 },
        "recordedAt": { "type": "string", "format": "date-time" }
      }
    },

    "fault": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "connection-refused",
            "connection-reset",
            "timeout",
            "dns-failure",
            "tls-error",
            "partial-response"
          ]
        },
        "afterMs": { "type": "number", "minimum": 0 },
        "message": { "type": "string" }
      }
    },

    "expect": {
      "type": "object",
      "properties": {
        "called": {
          "oneOf": [
            { "enum": ["once", "atLeastOnce", "never", "any"] },
            {
              "type": "object",
              "required": ["times"],
              "properties": { "times": { "type": "integer", "minimum": 0 } }
            }
          ]
        }
      }
    }
  }
}
